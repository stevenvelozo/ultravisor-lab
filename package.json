{
	"name": "ultravisor-lab",
	"version": "1.0.0",
	"description": "Web-based orchestration and monitoring for dockerized DB engines, retold-databeacons, Ultravisor, and Facto instances",
	"main": "lab.js",
	"bin": {
		"ultravisor-lab": "./lab.js"
	},
	"scripts": {
		"start": "node lab.js",
		"web": "node lab.js --web",
		"build-bundle": "npx quack build && npx quack copy",
		"test": "echo \"No tests yet\" && exit 0"
	},
	"copyFilesSettings": {
		"whenFileExists": "overwrite"
	},
	"copyFiles": [
		{
			"from": "./web/html/*",
			"to": "./web/dist/"
		},
		{
			"from": "./web/css/*",
			"to": "./web/dist/css/"
		},
		{
			"from": "./node_modules/pict/dist/*",
			"to": "./web/dist/js/"
		}
	],
	"dependencies": {
		"chance": "^1.1.13",
		"fable": "^3.1.72",
		"fable-serviceproviderbase": "^3.0.19",
		"meadow": "^2.0.39",
		"meadow-connection-sqlite": "^1.0.20",
		"meadow-endpoints": "^4.0.21",
		"meadow-integration": "^1.0.40",
		"meadow-migrationmanager": "^1.0.0",
		"orator": "^6.1.2",
		"orator-conversion": "^1.0.13",
		"orator-serviceserver-restify": "^2.0.11",
		"pict": "^1.0.368",
		"pict-application": "^1.0.34",
		"pict-router": "^1.0.10",
		"pict-section-modal": "^1.1.1",
		"pict-view": "^1.0.68",
		"retold-databeacon": "^1.0.3",
		"ultravisor": "^1.3.9",
		"ultravisor-beacon": "^1.0.0"
	},
	"devDependencies": {
		"gulp": "^4.0.2",
		"quackage": "^1.2.3"
	},
	"license": "MIT",
	"author": "Steven Velozo <steven@velozo.com>"
}
