{
	"Hash": "preset-ultravisor-promiscuous",
	"Name": "Ultravisor — Promiscuous (no login)",
	"Description": "Bare-minimum stack: a single Ultravisor with no auth beacon attached.  The web UI loads straight to the dashboard with no login screen — session-gated routes synthesize anonymous sessions because no provider could possibly mint a real one.  Useful for local development, automation testing, and as a smoke check that the UI works without an auth backend at all.",
	"SchemaVersion": 1,
	"Inputs":
	{
		"DataRoot":
		{
			"Type": "folder",
			"Default": "${HOME}/retold-stacks/ultravisor-promiscuous",
			"Description": "Where Ultravisor state (operation library, manifest store) persists on the host."
		},
		"MonorepoRoot":
		{
			"Type": "folder",
			"Default": "${env.RETOLD_MONOREPO_ROOT}",
			"Description": "Path to your retold monorepo checkout. Ultravisor is built from MonorepoRoot/modules/apps/ultravisor at launch."
		},
		"UVPort":
		{
			"Type": "port",
			"Default": 54321,
			"Description": "Host port for the Ultravisor API + web UI."
		},
		"DataBeaconPort":
		{
			"Type": "port",
			"Default": 8389,
			"Description": "Host port for the retold-databeacon web UI.  Exercises the new beacon-side login flow in promiscuous mode — the UI loads straight to the dashboard with no login (since UV has no auth beacon attached)."
		},
		"FactoPort":
		{
			"Type": "port",
			"Default": 8386,
			"Description": "Host port for the retold-facto web UI.  Promiscuous mode: no login required."
		},
		"ContentSystemPort":
		{
			"Type": "port",
			"Default": 7780,
			"Description": "Host port for the retold-content-system web UI.  Promiscuous mode: no login required."
		},
		"RemotePort":
		{
			"Type": "port",
			"Default": 7777,
			"Description": "Host port for the retold-remote web UI.  Also auto-registers orator-conversion as a sibling beacon."
		},
		"DataMapperPort":
		{
			"Type": "port",
			"Default": 18401,
			"Description": "Host port for the retold-data-mapper web UI."
		},
		"SynthBeaconPort":
		{
			"Type": "port",
			"Default": 8390,
			"Description": "Host port for the retold-synth-databeacon (synthetic-data source beacon for data-mapper integrations)."
		}
	},
	"Components":
	[
		{
			"Hash": "ultravisor",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/ultravisor",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.UVPort}", "Container": 54321 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/uv/data", "Container": "/app/data", "Mode": "rw" }
			],
			"Environment":
			{
				"ULTRAVISOR_LOG_LEVEL": "info"
			},
			"HealthCheck":
			{
				"Command": "node -e \"const h=require('http');h.get('http://localhost:54321/status',(r)=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))\"",
				"IntervalSec": 5,
				"TimeoutSec": 3,
				"RetriesBeforeFail": 12
			},
			"DependsOn": []
		},
		{
			"Hash": "retold-databeacon",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-databeacon",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.DataBeaconPort}", "Container": 8389 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/databeacon", "Container": "/app/data", "Mode": "rw" }
			],
			"Environment":
			{
				"DATABEACON_ULTRAVISOR_URL":   "http://${component.ultravisor.host}:54321",
				"DATABEACON_BEACON_NAME":      "retold-databeacon",
				"DATABEACON_MAX_CONCURRENT":   "3"
			},
			"DependsOn": [ "ultravisor" ]
		},

		{
			"Hash": "retold-facto",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-facto",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.FactoPort}", "Container": 8386 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/facto", "Container": "/app/data", "Mode": "rw" }
			],
			"Environment":
			{
				"FACTO_ULTRAVISOR_URL":  "http://${component.ultravisor.host}:54321",
				"FACTO_BEACON_NAME":     "retold-facto",
				"FACTO_MAX_CONCURRENT":  "2"
			},
			"DependsOn": [ "ultravisor" ]
		},

		{
			"Hash": "retold-content-system",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-content-system",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.ContentSystemPort}", "Container": 7780 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/content-system/data",    "Container": "/app/data",    "Mode": "rw" },
				{ "Host": "${input.DataRoot}/content-system/content", "Container": "/app/content", "Mode": "rw" }
			],
			"Command":
			[
				"node", "/app/source/cli/ContentSystem-CLI-Run.js", "serve", "/app/content",
				"-p", "7780",
				"-b", "http://ultravisor:54321",
				"--beacon-name", "retold-content-system"
			],
			"DependsOn": [ "ultravisor" ]
		},

		{
			"Hash": "retold-remote",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-remote",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.RemotePort}", "Container": 7777 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/remote/data",    "Container": "/app/data",    "Mode": "rw" },
				{ "Host": "${input.DataRoot}/remote/content", "Container": "/app/content", "Mode": "rw" }
			],
			"Command":
			[
				"node", "/app/source/cli/RetoldRemote-CLI-Run.js", "serve", "/app/content",
				"-p", "7777",
				"-u", "http://ultravisor:54321"
			],
			"DependsOn": [ "ultravisor" ]
		},

		{
			"Hash": "retold-data-mapper",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-data-mapper",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.DataMapperPort}", "Container": 18401 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/data-mapper", "Container": "/app/data", "Mode": "rw" }
			],
			"Command":
			[
				"node", "/app/bin/retold-data-mapper.js",
				"--port", "18401",
				"--ultravisor", "http://ultravisor:54321",
				"--name", "retold-data-mapper"
			],
			"DependsOn": [ "ultravisor" ]
		},

		{
			"Hash": "retold-synth-databeacon",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-synth-databeacon",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.SynthBeaconPort}", "Container": 8390 } ],
			"Environment":
			{
				"SYNTHBEACON_ULTRAVISOR_URL":  "http://${component.ultravisor.host}:54321",
				"SYNTHBEACON_BEACON_NAME":     "retold-synth-databeacon",
				"SYNTHBEACON_MAX_CONCURRENT":  "3"
			},
			"DependsOn": [ "ultravisor" ]
		}
	]
}
