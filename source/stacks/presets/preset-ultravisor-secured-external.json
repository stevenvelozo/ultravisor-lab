{
	"Hash": "preset-ultravisor-secured-external",
	"Name": "Ultravisor — Secured (external auth, no in-app user mgmt)",
	"Description": "Ultravisor + ultravisor-auth-beacon running the ExternalDirectoryAuthProvider.  Simulates a deployment whose user store lives outside Ultravisor (LDAP, OIDC, in-house IAM): the beacon validates credentials and mints sessions, but the in-app user management views are HIDDEN because the provider advertises `UserManagement: external` at registration.  Use this preset as a fixture for the third login mode — verify that login works, the dashboard renders, AND the Users tab is absent from the top nav.",
	"SchemaVersion": 1,
	"Inputs":
	{
		"DataRoot":
		{
			"Type": "folder",
			"Default": "${HOME}/retold-stacks/ultravisor-secured-external",
			"Description": "Where Ultravisor + auth-beacon state persist on the host."
		},
		"MonorepoRoot":
		{
			"Type": "folder",
			"Default": "${env.RETOLD_MONOREPO_ROOT}",
			"Description": "Path to your retold monorepo checkout. Ultravisor + auth-beacon are built from sibling checkouts at launch."
		},
		"DirectoryUser":
		{
			"Type": "string",
			"Default": "alice",
			"Description": "Username for the simulated external directory's seed account."
		},
		"DirectoryPassword":
		{
			"Type": "secret",
			"Default": "alice",
			"Description": "Password for the seed external-directory account.  Username/password pairs are validated against this in-memory directory but treated as if they came from a remote IdP."
		},
		"UVPort":
		{
			"Type": "port",
			"Default": 54321,
			"Description": "Host port for the Ultravisor API + web UI."
		},
		"DataBeaconPort":
		{
			"Type": "port",
			"Default": 8389,
			"Description": "Host port for the retold-databeacon web UI.  Login required using the seeded `DirectoryUser` / `DirectoryPassword` — same external auth provider as Ultravisor itself."
		},
		"FactoPort":
		{
			"Type": "port",
			"Default": 8386,
			"Description": "Host port for the retold-facto web UI.  Login required; uses DirectoryUser / DirectoryPassword."
		},
		"ContentSystemPort":
		{
			"Type": "port",
			"Default": 7780,
			"Description": "Host port for the retold-content-system web UI.  Login required; uses DirectoryUser / DirectoryPassword."
		},
		"RemotePort":
		{
			"Type": "port",
			"Default": 7777,
			"Description": "Host port for the retold-remote web UI.  Auto-registers orator-conversion alongside.  Login required."
		},
		"DataMapperPort":
		{
			"Type": "port",
			"Default": 18401,
			"Description": "Host port for the retold-data-mapper web UI.  Login required."
		},
		"SynthBeaconPort":
		{
			"Type": "port",
			"Default": 8390,
			"Description": "Host port for the retold-synth-databeacon (data source for mapping integrations)."
		}
	},
	"Components":
	[
		{
			"Hash": "ultravisor",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/ultravisor",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.UVPort}", "Container": 54321 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/uv/data", "Container": "/app/data", "Mode": "rw" }
			],
			"Environment":
			{
				"ULTRAVISOR_LOG_LEVEL": "info"
			},
			"HealthCheck":
			{
				"Command": "node -e \"const h=require('http');h.get('http://localhost:54321/status',(r)=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))\"",
				"IntervalSec": 5,
				"TimeoutSec": 3,
				"RetriesBeforeFail": 12
			},
			"DependsOn": []
		},
		{
			"Hash": "ultravisor-auth-beacon",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/ultravisor-auth-beacon",
			"Dockerfile": "Dockerfile",
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/auth-beacon/config", "Container": "/app/config", "Mode": "rw" }
			],
			"Files":
			[
				{
					"Path": "/app/config/auth-beacon.json",
					"Content": "{\n\t\"BeaconName\": \"auth-beacon\",\n\t\"UltravisorURL\": \"http://ultravisor:54321\",\n\t\"ProviderConfig\":\n\t{\n\t\t\"Users\":\n\t\t[\n\t\t\t{ \"Username\": \"${input.DirectoryUser}\", \"Password\": \"${input.DirectoryPassword}\", \"Roles\": [\"user\"], \"FullName\": \"Directory User\" }\n\t\t]\n\t}\n}\n"
				}
			],
			"Command":
			[
				"node",
				"bin/ultravisor-auth-beacon.js",
				"--config",
				"/app/config/auth-beacon.json",
				"--provider",
				"external-directory"
			],
			"DependsOn": [ "ultravisor" ]
		},
		{
			"Hash": "retold-databeacon",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-databeacon",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.DataBeaconPort}", "Container": 8389 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/databeacon", "Container": "/app/data", "Mode": "rw" }
			],
			"Environment":
			{
				"DATABEACON_ULTRAVISOR_URL":   "http://${component.ultravisor.host}:54321",
				"DATABEACON_BEACON_NAME":      "retold-databeacon",
				"DATABEACON_BEACON_PASSWORD":  "${input.DirectoryPassword}",
				"DATABEACON_MAX_CONCURRENT":   "3"
			},
			"DependsOn": [ "ultravisor", "ultravisor-auth-beacon" ]
		},

		{
			"Hash": "retold-facto",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-facto",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.FactoPort}", "Container": 8386 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/facto", "Container": "/app/data", "Mode": "rw" }
			],
			"Environment":
			{
				"FACTO_ULTRAVISOR_URL":  "http://${component.ultravisor.host}:54321",
				"FACTO_BEACON_NAME":     "retold-facto",
				"FACTO_BEACON_PASSWORD": "${input.DirectoryPassword}",
				"FACTO_MAX_CONCURRENT":  "2"
			},
			"DependsOn": [ "ultravisor", "ultravisor-auth-beacon" ]
		},

		{
			"Hash": "retold-content-system",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-content-system",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.ContentSystemPort}", "Container": 7780 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/content-system/data",    "Container": "/app/data",    "Mode": "rw" },
				{ "Host": "${input.DataRoot}/content-system/content", "Container": "/app/content", "Mode": "rw" }
			],
			"Command":
			[
				"node", "/app/source/cli/ContentSystem-CLI-Run.js", "serve", "/app/content",
				"-p", "7780",
				"-b", "http://ultravisor:54321",
				"--beacon-name", "retold-content-system",
				"--beacon-password", "${input.DirectoryPassword}"
			],
			"DependsOn": [ "ultravisor", "ultravisor-auth-beacon" ]
		},

		{
			"Hash": "retold-remote",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-remote",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.RemotePort}", "Container": 7777 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/remote/data",    "Container": "/app/data",    "Mode": "rw" },
				{ "Host": "${input.DataRoot}/remote/content", "Container": "/app/content", "Mode": "rw" }
			],
			"Command":
			[
				"node", "/app/source/cli/RetoldRemote-CLI-Run.js", "serve", "/app/content",
				"-p", "7777",
				"-u", "http://ultravisor:54321"
			],
			"DependsOn": [ "ultravisor", "ultravisor-auth-beacon" ]
		},

		{
			"Hash": "retold-data-mapper",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-data-mapper",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.DataMapperPort}", "Container": 18401 } ],
			"Volumes":
			[
				{ "Host": "${input.DataRoot}/data-mapper", "Container": "/app/data", "Mode": "rw" }
			],
			"Command":
			[
				"node", "/app/bin/retold-data-mapper.js",
				"--port", "18401",
				"--ultravisor", "http://ultravisor:54321",
				"--name", "retold-data-mapper"
			],
			"DependsOn": [ "ultravisor", "ultravisor-auth-beacon" ]
		},

		{
			"Hash": "retold-synth-databeacon",
			"Type": "docker-build-from-folder",
			"BuildContext": "${input.MonorepoRoot}/modules/apps/retold-synth-databeacon",
			"Dockerfile": "Dockerfile",
			"Ports": [ { "Host": "${input.SynthBeaconPort}", "Container": 8390 } ],
			"Environment":
			{
				"SYNTHBEACON_ULTRAVISOR_URL":  "http://${component.ultravisor.host}:54321",
				"SYNTHBEACON_BEACON_NAME":     "retold-synth-databeacon",
				"SYNTHBEACON_BEACON_PASSWORD": "${input.DirectoryPassword}",
				"SYNTHBEACON_MAX_CONCURRENT":  "3"
			},
			"DependsOn": [ "ultravisor", "ultravisor-auth-beacon" ]
		}
	]
}
